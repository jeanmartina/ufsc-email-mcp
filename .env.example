# ==============================================================================
# Configuração do Servidor MCP de E-mail (UFSC IMAP)
# ==============================================================================

# Credenciais e conexão IMAP da UFSC
IMAP_HOST=imap.ufsc.br
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=seu.idufsc@ufsc.br
IMAP_PASSWORD=sua_senha_idufsc

# Permite operações de escrita (marcar como lido, mover mensagens, salvar rascunhos)
# Se definido como true, o servidor opera em modo somente-leitura.
IMAP_READ_ONLY=false

# ==============================================================================
# Configurações do Servidor HTTP / Streamable HTTP (para ChatGPT, Orca, n8n, etc.)
# ==============================================================================
PORT=8087
HOST=0.0.0.0

# Token Bearer de segurança para proteger o endpoint HTTP MCP (ex: Authorization: Bearer <token>)
# Gere uma chave aleatória segura para usar como seu token.
MCP_AUTH_TOKEN=gere_um_token_seguro_aqui_ex_openssl_rand_hex_32
